# Database
DATABASE_URL=postgresql://user:password@localhost:5432/geotech_db

# JWT
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Payment APIs
STRIPE_SECRET_KEY=sk_test_xxxxx
CLICK_MERCHANT_ID=xxxxx
CLICK_SERVICE_ID=xxxxx
CLICK_SECRET_KEY=xxxxx
PAYME_MERCHANT_ID=xxxxx
PAYME_SECRET_KEY=xxxxx

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@geotech.com

# Environment
DEBUG=True
ENVIRONMENT=development
APP_NAME=GEO TECH
